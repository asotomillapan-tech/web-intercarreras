# GEMINI_API_KEY: Required for server-side Gemini Vision scoresheet validation (/api/ai/validate-scoresheet).
# Configure this in Vercel -> Project Settings -> Environment Variables (Production & Preview).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Optional override for server-side Firebase JWT verification.
# Defaults automatically to firebase-applet-config.json ("gen-lang-client-0001236669").
FIREBASE_PROJECT_ID="gen-lang-client-0001236669"

# APP_URL: The public URL where this app is hosted (optional, injected automatically in AI Studio).
APP_URL="MY_APP_URL"

# Turso (libSQL) Server-Side Database Credentials (NEVER prefix with VITE_ or expose to the browser).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

