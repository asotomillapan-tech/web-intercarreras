  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfiles de usuario con rol RBAC, favoritos y vínculo opcional a jugador o equipo."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Lista confiable de administradores con privilegios exclusivos de cambio de rol y designación de otros admins."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/TournamentSettings" },
      "description": "Configuración global del campeonato (carpeta raíz Drive 2026 y sincronización Google Sheets)."
    },
    "/configs/{disciplineId}": {
      "schema": { "$ref": "#/entities/DisciplineConfig" },
      "description": "Configuración anual de cupos, grupos, playoffs, inscripciones y transferencias por disciplina."
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Equipos oficiales inscritos por disciplina con escudo transparente y año de fundación."
    },
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerPublic" },
      "description": "Perfiles deportivos públicos de jugadores (sin datos PII sensibles)."
    },
    "/player_private/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerPrivate" },
      "description": "PII estudiantil UFRO aislado (RUT, matrícula, correo institucional, fecha nacimiento)."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Encuentros oficiales con control arbitral y bloqueo de estado terminal al finalizar."
    },
    "/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/TransferRecord" },
      "description": "Historial oficial de transferencias post-fase de grupos."
    },
    "/mvp_votes/{voteId}": {
      "schema": { "$ref": "#/entities/MvpVote" },
      "description": "Votos individuales de POTM (Player of the Match) por partido."
    },
    "/award_nominees/{disciplineId}": {
      "schema": { "$ref": "#/entities/AwardNominees" },
      "description": "Lista oficial administrada por Admin con hasta 5 jugadores nominados al MVP del Campeonato por disciplina."
    },
    "/championship_mvp_votes/{voteId}": {
      "schema": { "$ref": "#/entities/ChampionshipMvpVote" },
      "description": "Votos únicos de usuarios registrados por el MVP del Campeonato por disciplina."
    },
    "/position_award_votes/{voteId}": {
      "schema": { "$ref": "#/entities/PositionAwardVote" },
      "description": "Votos únicos de usuarios registrados por premios individuales por posición deportiva."
    },
    "/toty_ballots/{ballotId}": {
      "schema": { "$ref": "#/entities/TotyBallot" },
      "description": "Papeletas individuales de Equipo Ideal (TOTY) por disciplina y usuario registrado."
    },
    "/toty_configs/{disciplineId}": {
      "schema": { "$ref": "#/entities/TotyConfig" },
      "description": "Configuración administrada por Admin de la formación y posiciones exactas del TOTY por disciplina."
    },
    "/photos/{photoId}": {
      "schema": { "$ref": "#/entities/PhotoEntry" },
      "description": "Índice fotográfico oficial conectado a Google Drive y subidas de prensa UFRO."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "Noticias del Campeonato y anuncios destacados gestionados por Prensa Oficial y Administradores."
    },
    "/leyendas_leaderboard/{entryId}": {
      "schema": { "$ref": "#/entities/LeyendasLeaderboardEntry" },
      "description": "Ranking Global Semanal del minijuego LEYENDAS UFRO (registros inmutables por carrera finalizada)."
    }
  }
}
