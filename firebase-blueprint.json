{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario autenticado con Google Sign-In del Campeonato Intercarreras UFRO con rol RBAC y equipos favoritos.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "fechaNacimiento": {
          "type": "string",
          "maxLength": 20
        },
        "carrera": {
          "type": "string",
          "maxLength": 140
        },
        "facultad": {
          "type": "string",
          "maxLength": 140
        },
        "telefono": {
          "type": "string",
          "maxLength": 30
        },
        "role": {
          "type": "string",
          "enum": ["tradicional", "jugador", "delegado", "arbitro", "fotografo", "prensa", "admin"]
        },
        "favoriteTeamIds": {
          "type": "array",
          "description": "Lista acotada de hasta 20 IDs de equipos favoritos para notificaciones."
        },
        "linkedPlayerId": {
          "type": "string",
          "maxLength": 128
        },
        "delegatedTeamId": {
          "type": "string",
          "maxLength": 128
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "favoriteTeamIds", "notificationsEnabled", "createdAt", "updatedAt"]
    },
